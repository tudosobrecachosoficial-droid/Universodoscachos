    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^18.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
