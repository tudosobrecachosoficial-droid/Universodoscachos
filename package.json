{
  "name": "projeto-cachos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build && tsx scripts/prerender.ts",
    "build:app": "tsc && vite build",
    "prerender": "tsx scripts/prerender.ts",
