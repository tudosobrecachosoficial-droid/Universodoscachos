# --- Supabase (public client; protected by Row Level Security) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Site ---
# Public address, with https and no trailing slash. Used for canonical links,
# Open Graph images, sitemap.xml and robots.txt.
VITE_SITE_URL=https://www.example.com

# --- Analytics and ads (loaded only after the visitor accepts cookies) ---
# Google Tag Manager container. Leave empty to turn it off.
VITE_GTM_ID=GTM-PXGZP4SG
# AdSense publisher id (ca-pub-0000000000000000). Leave empty to hide ads.
VITE_ADSENSE_CLIENT=
# Ad unit ids created in AdSense (middle and end of each article).
VITE_ADSENSE_SLOT_ARTICLE_MID=
VITE_ADSENSE_SLOT_ARTICLE_END=

# --- Local scripts only (scripts/migrate-*.ts). NEVER prefix with VITE_ and never commit. ---
SUPABASE_SERVICE_ROLE_KEY=
